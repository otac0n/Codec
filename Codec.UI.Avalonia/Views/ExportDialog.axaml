<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:vm="using:Codec.UI.Avalonia.ViewModels"
    x:Class="Codec.UI.Avalonia.Views.ExportDialog"
    x:DataType="vm:ExportViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="Export Files"
    WindowStartupLocation="CenterOwner"
    Width="400"
    Height="500">
    <Grid Margin="20" ColumnDefinitions="Auto, Auto, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, *, Auto" Background="Transparent">
        <TextBlock Grid.Column="0" Grid.Row="0" Text="Destination Folder:" VerticalAlignment="Center" Margin="0,0,15,0" />
        <Grid Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" RowDefinitions="Auto">
            <TextBox Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Text="{Binding Destination}" />
            <Button Grid.Column="1" Grid.Row="0" Content="{iconPacks:FontAwesome Kind=FolderOpenSolid}" Command="{Binding BrowseCommand}" CommandParameter="{Binding $parent[Window]}" />
        </Grid>
        <TextBlock Grid.Column="0" Grid.Row="1" Text="Include Pattern:" VerticalAlignment="Center" Margin="0,0,15,0">
            <Control.IsVisible>
                <Binding Path="AnyFolders" />
            </Control.IsVisible>
        </TextBlock>
        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" Text="{Binding IncludeFormat}">
            <Control.IsVisible>
                <Binding Path="AnyFolders" />
            </Control.IsVisible>
        </TextBox>
        <CheckBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Content="Include Referenced Files" VerticalAlignment="Center" IsChecked="{Binding IncludeReferences}">
            <Control.IsVisible>
                <!-- Currently we only support references from models. -->
                <Binding Path="AnyModels" />
            </Control.IsVisible>
        </CheckBox>
        <CheckBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Content="Export Subfolders" VerticalAlignment="Center" IsChecked="{Binding Recursive}">
            <Control.IsVisible>
                <Binding Path="AnyFolders" />
            </Control.IsVisible>
        </CheckBox>
        <CheckBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" Content="Include Archives" VerticalAlignment="Center" IsChecked="{Binding RecurseArchives}">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="AnyFolders" />
                    <Binding Path="Recursive" />
                </MultiBinding>
            </Control.IsVisible>
        </CheckBox>
        <TextBlock Grid.Column="1" Grid.Row="5" Text="Depth:" VerticalAlignment="Center" Margin="0,0,15,0">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="AnyFolders" />
                    <Binding Path="Recursive" />
                    <Binding Path="RecurseArchives" />
                </MultiBinding>
            </Control.IsVisible>
        </TextBlock>
        <NumericUpDown Grid.Column="2" Grid.Row="5" Minimum="1" Maximum="200" VerticalAlignment="Center" Value="{Binding Depth}">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="AnyFolders" />
                    <Binding Path="Recursive" />
                    <Binding Path="RecurseArchives" />
                </MultiBinding>
            </Control.IsVisible>
        </NumericUpDown>
        <CheckBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="6" Content="Convert Models" VerticalAlignment="Center" IsChecked="{Binding ConvertModels}">
            <Control.IsVisible>
                <Binding Path="AnyModels" />
            </Control.IsVisible>
        </CheckBox>
        <TextBlock Grid.Column="1" Grid.Row="7" Text="Format:" VerticalAlignment="Center" Margin="0,0,15,0">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="AnyModels" />
                    <Binding Path="ConvertModels" />
                </MultiBinding>
            </Control.IsVisible>
        </TextBlock>
        <TextBox Grid.Column="2" Grid.Row="7" VerticalAlignment="Center" IsVisible="{Binding ConvertModels}" Text="{Binding ModelFormat}">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="AnyModels" />
                    <Binding Path="ConvertModels" />
                </MultiBinding>
            </Control.IsVisible>
        </TextBox>
        <CheckBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="8" Content="Convert Images" VerticalAlignment="Center" IsChecked="{Binding ConvertImages}">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="AnyImages" />
                    <!-- Currently references from models could be images. -->
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="AnyModels" />
                        <Binding Path="IncludeReferences" />
                    </MultiBinding>
                </MultiBinding>
            </Control.IsVisible>
        </CheckBox>
        <TextBlock Grid.Column="1" Grid.Row="9" Text="Format:" VerticalAlignment="Center" Margin="0,0,15,0">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="AnyImages" />
                        <!-- Currently references from models could be images. -->
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="AnyModels" />
                            <Binding Path="IncludeReferences" />
                        </MultiBinding>
                    </MultiBinding>
                    <Binding Path="ConvertImages" />
                </MultiBinding>
            </Control.IsVisible>
        </TextBlock>
        <TextBox Grid.Column="2" Grid.Row="9" VerticalAlignment="Center" Text="{Binding ImageFormat}">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="AnyImages" />
                        <!-- Currently references from models could be images. -->
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="AnyModels" />
                            <Binding Path="IncludeReferences" />
                        </MultiBinding>
                    </MultiBinding>
                    <Binding Path="ConvertImages" />
                </MultiBinding>
            </Control.IsVisible>
        </TextBox>
        <!-- We don't currently support converting audio. -->
        <CheckBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="10" Content="Convert Audio" VerticalAlignment="Center" IsChecked="{Binding ConvertAudio}" IsEnabled="false">
            <Control.IsVisible>
                <Binding Path="AnyAudio" />
            </Control.IsVisible>
        </CheckBox>
        <TextBlock Grid.Column="1" Grid.Row="11" Text="Format:" VerticalAlignment="Center" Margin="0,0,15,0" IsVisible="{Binding ConvertAudio}">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="AnyAudio" />
                    <Binding Path="ConvertAudio" />
                </MultiBinding>
            </Control.IsVisible>
        </TextBlock>
        <TextBox Grid.Column="2" Grid.Row="11" VerticalAlignment="Center" IsVisible="{Binding ConvertAudio}" Text="{Binding AudioFormat}">
            <Control.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="AnyAudio" />
                    <Binding Path="ConvertAudio" />
                </MultiBinding>
            </Control.IsVisible>
        </TextBox>
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="13" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Click="OnAccept" Width="75" HotKey="Enter" IsEnabled="{Binding Valid}" />
            <Button Content="Cancel" Click="OnCancel" Width="75" HotKey="Escape" />
        </StackPanel>
    </Grid>
</Window>
