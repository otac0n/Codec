<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Codec.UI.Avalonia.ViewModels"
        x:Class="Codec.UI.Avalonia.Views.ProgressWindow"
        x:DataType="vm:ProgressViewModel"
        Title="Progress"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto">
        <ProgressBar Grid.Row="0" Height="16" Minimum="0" Maximum="1" Value="{Binding Progress}" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding ProgressText}" />
        <Button Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Content="Cancel" Command="{Binding CancelExportCommand}" />
    </Grid>
</Window>
